[Unit]
Description=catbowl per-cat feeder
After=network-online.target
Wants=network-online.target
# No camera, no feeder. The condition is re-checked on every start attempt, so
# an unplugged rig sits quietly instead of restart-looping; the udev rule in
# 99-catbowl.rules starts the service the moment a camera appears.
ConditionPathExistsGlob=/dev/video*
# Restart forever. The default burst limit would give up after a few crashes,
# which for a feeder means the lids stay shut until someone notices.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
# A camera plugged in at boot may not have finished enumerating when udev fires.
ExecStartPre=/bin/sleep 2
# --config is a top-level flag: it belongs before the subcommand, not after.
# __FLAGS__ is normally empty. install_service.sh puts --no-model there when
# no classifier has been trained yet, so the rig collects photos instead of
# exiting; re-run the installer once you have a model to take it back out.
ExecStart=__DIR__/.venv/bin/python -m catbowl --config config/bowls.yaml run __FLAGS__
Restart=always
RestartSec=5
# If the process dies, systemd restarts it and the first thing FeederApp does is
# drive every lid closed - so a crash leaves the bowls shut, not open.
StandardOutput=journal
StandardError=journal
# Cameras, I2C and GPIO are group-owned; __USER__ needs to be in these for the
# unit to reach the hardware. install_service.sh adds them.
SupplementaryGroups=video i2c gpio

# Modest hardening; the service still needs /dev/video*, /dev/i2c-* and GPIO.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# The checkout, plus torchvision's weight cache: the detector downloads the
# ssdlite weights into ~/.cache/torch the first time it is built, and under
# ProtectHome=read-only that is an OSError and a restart loop. Allow-listed
# rather than redirected, so the service shares one cache with the runs you
# start by hand. The leading `-` keeps the unit startable before it exists.
ReadWritePaths=__DIR__ -__HOME__/.cache/torch

[Install]
WantedBy=multi-user.target
